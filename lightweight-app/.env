# Local-only frontend environment example.
# This file is not used by the Terraform-managed GCP deployment.
# Only fill these values in if you want to run `lightweight-app` on your
# machine and point it at already-deployed cloud services.

FLASK_SECRET_KEY=replace-with-a-local-secret
GCP_PROJECT=your-gcp-project-id
PUBSUB_TOPIC=scholarminer-index-tasks
DB_HOST=replace-with-cloudsql-private-ip-or-proxy-host
DB_PORT=5432
DB_NAME=ieee_search
DB_USER=app_user
DB_PASSWORD=replace-with-db-password
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
PORT=5000
