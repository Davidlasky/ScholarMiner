#!/bin/bash
set -euo pipefail

apt-get update
apt-get install -y docker.io
systemctl enable docker
systemctl start docker

docker rm -f scholarminer-web scholarminer-web-node-exporter || true
docker pull ${frontend_image}

docker run -d --name scholarminer-web-node-exporter --restart unless-stopped -p 9100:9100 \
  prom/node-exporter:latest

docker run -d --name scholarminer-web --restart unless-stopped -p 5000:5000 \
  -e PORT=5000 \
  -e GCP_PROJECT="${project_id}" \
  -e PUBSUB_TOPIC="${pubsub_topic}" \
  -e DB_HOST="${db_host}" \
  -e DB_PORT="5432" \
  -e DB_NAME="${db_name}" \
  -e DB_USER="${db_user}" \
  -e DB_PASSWORD_SECRET="${db_password_secret}" \
  -e REDIS_HOST="${redis_host}" \
  -e REDIS_PORT="${redis_port}" \
  -e FLASK_SECRET_SECRET="${flask_secret_secret}" \
  -e TASK_STATUS_POLL_INTERVAL="5" \
  "${frontend_image}"
